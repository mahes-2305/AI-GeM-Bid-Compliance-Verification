# ================================
# Node.js
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ================================
# Environment / Secrets
# ================================
.env
.env.*
!.env.example

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx

# ================================
# Terraform
# ================================
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*

# Terraform variable files may contain secrets
terraform/*.tfvars
terraform/*.tfvars.json

# ================================
# Backend generated data
# ================================
backend/uploads/
backend/data/*.json
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# ================================
# Build output
# ================================
frontend/dist/
frontend/build/

# ================================
# Logs
# ================================
*.log
logs/

# ================================
# OS / Editor
# ================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ================================
# Temporary files
# ================================
scratch/
*.tmp
*.temp
